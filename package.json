{
  "name": "eslint-config-cheminfo-react",
  "version": "21.0.1",
  "description": "Shared ESLint config for projects using React",
  "type": "module",
  "exports": {
    ".": "./configs/index.js",
    "./base": "./configs/base.js",
    "./utilities": "./configs/utilities.js"
  },
  "files": [
    "configs"
  ],
  "scripts": {
    "eslint": "eslint configs/*.js test/test.js test/rule_helpers.js",
    "eslint-fix": "npm run eslint -- --fix",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "npm run test-only && npm run eslint && npm run prettier",
    "test-only": "node test/test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/eslint-config-cheminfo-react.git"
  },
  "keywords": [],
  "author": "Michaël Zasso",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cheminfo/eslint-config-cheminfo-react/issues"
  },
  "homepage": "https://github.com/cheminfo/eslint-config-cheminfo-react#readme",
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.19.1",
    "eslint-config-cheminfo": "^19.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "globals": "^17.12.0"
  },
  "peerDependencies": {
    "eslint": "^10.10.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@zakodium/tsconfig": "^1.0.5",
    "eslint": "10.10.0",
    "eslint-config-cheminfo-typescript": "^23.0.0",
    "prettier": "^3.9.7",
    "react": "^18.3.1",
    "typescript": "^6.0.3"
  }
}
